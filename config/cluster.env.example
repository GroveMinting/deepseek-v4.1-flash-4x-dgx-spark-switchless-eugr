# Copy to config/cluster.env and edit. This is a trusted shell fragment.

EUGR_DIR="../spark-vllm-docker"
SSH_USER="spark"
SSH_PORT="22"
SSH_KEY=""

# Rank order. Rank 0 is the eugr head and API node.
NODE0_MGMT="192.168.1.101"
NODE1_MGMT="192.168.1.102"
NODE2_MGMT="192.168.1.103"
NODE3_MGMT="192.168.1.104"

# Management Ethernet or Wi-Fi carries SSH, Gloo, bootstrap and API traffic.
MGMT_IF="enP7s7"

# Canonical switchless fabric. Confirm every interface and HCA locally with:
#   ip -br link
#   ls /sys/class/infiniband
F1_IF="enp1s0f1np1"
F0_IF="enp1s0f0np0"
F1_HCA="rocep1s0f1"
F0_HCA="rocep1s0f0"
GID_INDEX="3"

# Four passive QSFP28 DACs form this ring:
# 0:f1—1:f1, 1:f0—2:f0, 2:f1—3:f1, 3:f0—0:f0.
NODE0_F1="10.10.10.1"
NODE0_F0="10.10.40.1"
NODE1_F1="10.10.10.2"
NODE1_F0="10.10.20.2"
NODE2_F1="10.10.30.3"
NODE2_F0="10.10.20.3"
NODE3_F1="10.10.30.4"
NODE3_F0="10.10.40.4"

MTU="9000"

# fabric-setup.sh --apply refuses unless this is changed after reviewing its
# dry-run output and physically tracing all four ring cables.
I_UNDERSTAND_SWITCHLESS_NETWORK_CHANGES="NO"

# Diagnostic fallback only: all four HCAs must reach the same switched RoCE LAN.
SWITCHED_HCA="rocep1s0f0"
SWITCHED_GID_INDEX="3"

MODEL_CACHE="/home/spark/.cache/huggingface"
# Set this to the resolved snapshot path printed by the download command. It
# must be visible at the same path on every rank.
MODEL_DIR=""

# Rank-local Engram rows live under the Hugging Face cache because eugr already
# bind-mounts that cache at /root/.cache/huggingface in every container.
ENGRAM_LOCAL_ROOT="/home/spark/.cache/huggingface/engram-local/DeepSeek-V4.1-Flash"
ENGRAM_CONTAINER_ROOT="/root/.cache/huggingface/engram-local/DeepSeek-V4.1-Flash"

B12X_SOURCE_IMAGE=""
# Qualification only. The rendered B12X recipe and its in-container check both
# refuse to run while this remains NO.
DSV41_ALLOW_UNQUALIFIED_B12X="NO"
